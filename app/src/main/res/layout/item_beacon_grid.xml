<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="128dp"
    android:layout_margin="6dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="18dp"
    app:cardElevation="1dp"
    app:strokeWidth="2dp"
    app:strokeColor="@color/transparent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp">

                <View
                    android:id="@+id/mini_circle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_circle_mini_gray" />

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_beacon"
                    android:contentDescription="@string/app_name"
                    app:tint="@color/white" />
            </FrameLayout>

            <TextView
                android:id="@+id/txt_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:text="信标" />

            <TextView
                android:id="@+id/txt_tag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:maxLines="1"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!--
          左上角电量：只出一个很小的电池图标（绿=充足 / 橙=一般 / 红=偏低），
          **不写数字**——数值在详情里看，卡片上留给信号和距离。
          没收到 TLM 就整块藏起来（那是设备能力，不是故障）。
          右上角是拖拽手柄，两者不打架。
        -->
        <ImageView
            android:id="@+id/iv_battery"
            android:layout_width="19dp"
            android:layout_height="11dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="9dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/ic_battery_ok"
            android:contentDescription="@string/info_battery"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/iv_drag"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="top|end"
            android:padding="4dp"
            android:src="@drawable/ic_drag_handle"
            android:contentDescription="@string/drag_to_sort" />

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
